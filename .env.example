# MySawit Shipment Service — Environment Configuration
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control.


# --- Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8084

# --- Database (PostgreSQL / Supabase) ---
# Use the Supabase Direct Connection JDBC URL.
# For EC2 dual-stack deploys, keep the hostname form so the JVM can resolve AAAA records.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# --- JWT (must match the Auth Service secret) ---
JWT_SECRET=replace-with-base64-encoded-secret-min-32-chars
JWT_EXPIRATION=86400000

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- JVM / Networking ---
# Prefer IPv6 for outbound DNS lookups while still allowing IPv4 inbound access on EC2.
JAVA_OPTS=-Xms256m -Xmx768m
JAVA_TOOL_OPTIONS=-Djava.net.preferIPv6Addresses=true -Djava.net.preferIPv4Stack=false -Dsun.net.inetaddr.ttl=60
