# MySawit Shipment Service — Environment Configuration
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control.


# --- Server ---
SERVER_PORT=8084

# --- Database (PostgreSQL / Supabase) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mysawit_shipment
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# --- JWT (must match the Auth Service secret) ---
JWT_SECRET=replace-with-base64-encoded-secret-min-32-chars
JWT_EXPIRATION=86400000

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
