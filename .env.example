# MySawit Shipment Service — Environment Configuration
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control.


# --- Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8084

# --- Database (PostgreSQL / Supabase) ---
# Use the Supabase Shared Pooler JDBC URL for IPv4-compatible local/dev connections.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.luymlqdyfvvrmnepsgsj
SPRING_DATASOURCE_PASSWORD=PASTE_SUPABASE_PASSWORD_HERE

# --- JWT (must match the Auth Service secret) ---
JWT_SECRET=replace-with-base64-encoded-secret-min-32-chars
JWT_EXPIRATION=86400000

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- RabbitMQ / CloudAMQP ---
# Get this URL from your CloudAMQP dashboard → instance → AMQP URL.
# Format: amqps://<user>:<password>@<hostname>/<vhost>
CLOUDAMQP_URL=amqps://user:password@hostname.cloudamqp.com/vhost

# --- Shipment business rules ---
SHIPMENT_MAX_WEIGHT_KG=400

# --- Local shipment-only testing ---
# In local profile this can be false so FE can test shipment flows without RabbitMQ/payroll/notification services.
SHIPMENT_EVENTS_ENABLED=true

# --- JVM / Networking ---
# Prefer IPv6 for outbound DNS lookups while still allowing IPv4 inbound access on EC2.
JAVA_OPTS=-Xms256m -Xmx768m
JAVA_TOOL_OPTIONS=-Djava.net.preferIPv6Addresses=true -Djava.net.preferIPv4Stack=false -Dsun.net.inetaddr.ttl=60
